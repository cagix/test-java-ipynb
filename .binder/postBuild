#!/usr/bin/env bash
set -euxo pipefail

# 1) JDK 25 in ein benutzerschreibbares Verzeichnis installieren
INSTALL_BASE="${HOME}/.local/jdk"
mkdir -p "${INSTALL_BASE}"

curl -L -o /tmp/jdk.tar.gz "https://api.adoptium.net/v3/binary/latest/25/ga/linux/x64/jdk/hotspot/normal/eclipse"
tar -C "${INSTALL_BASE}" -xzf /tmp/jdk.tar.gz

# Gefundenes JDK-Verzeichnis bestimmen und Symlink "current" setzen
JDK_DIR="$(find "${INSTALL_BASE}" -maxdepth 1 -type d -name 'jdk-*' | head -n1)"
ln -sfn "${JDK_DIR}" "${INSTALL_BASE}/current"

# 2) IJava-Kernel installieren (mit dem frisch installierten JDK im PATH)
IJAVA_VERSION=1.3.0
curl -L -o /tmp/ijava.zip "https://github.com/SpencerPark/IJava/releases/download/v${IJAVA_VERSION}/ijava-${IJAVA_VERSION}.zip"
unzip -q /tmp/ijava.zip -d /tmp/ijava
JAVA_HOME="${JDK_DIR}" PATH="${JDK_DIR}/bin:${PATH}" python3 /tmp/ijava/install.py --sys-prefix

# 3) Kernelspec robust machen: absoluten Pfad zu java eintragen + JAVA_HOME setzen
export JDK_DIR
KERNEL_DIR="$(jupyter kernelspec list --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["kernelspecs"]["java"]["resource_dir"])')"
export KERNEL_DIR
python3 - <<'PY'
import json, os
p = os.path.join(os.environ["KERNEL_DIR"], "kernel.json")
with open(p) as f:
    data = json.load(f)
argv = data.get("argv", [])
if argv and argv[0] == "java":
    argv[0] = os.path.join(os.environ["JDK_DIR"], "bin", "java")
env = data.get("env", {})
env["JAVA_HOME"] = os.environ["JDK_DIR"]
data["argv"] = argv
data["env"] = env
with open(p, "w") as f:
    json.dump(data, f, indent=2)
PY

# 4) Sanity-Checks (erscheint im Binder-Log)
"${JDK_DIR}/bin/java" -version
jupyter kernelspec list
